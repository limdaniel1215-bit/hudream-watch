[Unit]
Description=Hudream room availability watcher
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/hudream-watch
EnvironmentFile=/home/ubuntu/hudream-watch/.env
ExecStart=/home/ubuntu/hudream-watch/.venv/bin/python /home/ubuntu/hudream-watch/app.py
Restart=on-failure
RestartSec=30
StartLimitIntervalSec=600
StartLimitBurst=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/home/ubuntu/hudream-watch/data /home/ubuntu/hudream-watch/profile /home/ubuntu/hudream-watch/logs

[Install]
WantedBy=multi-user.target

